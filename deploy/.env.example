# CREW-Wildfire settings.
# Copy this file to ".env" in the same folder and fill it in:   cp .env.example .env
# Lines starting with # are comments. Do not put quotes around values.

# ---------------------------------------------------------------------------
# Website address (required)
# ---------------------------------------------------------------------------
# With a domain name (HTTPS certificates are obtained automatically):
#   SITE_ADDRESS=example.com, www.example.com
# Without a domain, use the server's public IP for plain HTTP:
#   SITE_ADDRESS=http://12.34.56.78
SITE_ADDRESS=

# ---------------------------------------------------------------------------
# Language model that powers the AI agents: "openai" or "local"
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai

# openai mode, optional: put your OpenAI API key here and players will not be
# asked for one. Leave empty and each lobby creator enters their own key on the site.
OPENAI_API_KEY=

# local mode (LLM_PROVIDER=local): runs a model on this server's GPU with vLLM.
# Remove the # from the next line so the model server starts with everything else.
#COMPOSE_PROFILES=local-llm

# Hugging Face model to run. The default fits a 24 GB GPU (g6.xlarge);
# google/gemma-4-31B-it-qat-w4a16-ct needs a 48 GB GPU (g6e.xlarge).
LLM_MODEL=google/gemma-4-12B-it-qat-w4a16-ct

# Where the AI agents reach the model server. Leave as is unless vLLM runs elsewhere.
LLM_BASE_URL=http://vllm:8000/v1

# Only needed if your model server requires a key. Leave empty for the built-in vLLM.
LLM_API_KEY=

# Hugging Face access token (huggingface.co -> Settings -> Access Tokens).
# Required for Gemma: you must also accept the model licence on its Hugging Face page once.
HF_TOKEN=

# Longest prompt the model accepts, in tokens. Larger values use more GPU memory.
VLLM_MAX_MODEL_LEN=32768

# Share of the GPU memory the model server may take (0.6 = 60%).
# The rest is needed by the game engine, which renders on the same GPU.
VLLM_GPU_MEMORY_UTILIZATION=0.6
