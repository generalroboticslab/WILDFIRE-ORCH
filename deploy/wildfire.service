[Unit]
Description=CREW-Wildfire containers (docker compose)
Requires=docker.service wildfire-x.service
After=docker.service wildfire-x.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/wildfire
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
User=ubuntu
Group=docker
# Starting waits for every container to report healthy; never time that out
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
