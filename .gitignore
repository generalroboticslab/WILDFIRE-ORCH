# Secrets and local settings
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node / Next.js (wildfire-human-interface)
node_modules/
.next/
*.tsbuildinfo
